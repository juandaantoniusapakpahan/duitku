option_settings:
  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: prod
    # Set these in the EB console (Configuration > Software > Environment properties)
    # instead of committing real secrets here:
    # DB_URL: jdbc:postgresql://<rds-endpoint>:5432/duitku
    # DB_USERNAME: duitku
    # DB_PASSWORD: <set-in-console>
    # JWT_SECRET: <set-in-console>
    # CORS_ALLOWED_ORIGIN: https://<your-amplify-domain>
  aws:autoscaling:launchconfiguration:
    InstanceType: t3.micro
